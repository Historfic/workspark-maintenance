# Copy to .env.local and fill in. Never commit real values.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-fable-5-1.
ANTHROPIC_MODEL=

# Supabase — Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser; RLS limits it to reads.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only.
SUPABASE_SECRET_KEY=
# Session pooler connection string. Used only by `pnpm db:migrate`.
DATABASE_URL=

# Retell — https://dashboard.retellai.com → Settings → API Keys
# The API key with the webhook badge. Server only: it checks the x-retell-signature header on
# /api/webhooks/retell.
RETELL_API_KEY=
# Public key for the browser call. Restrict it in the Retell dashboard to the site's domains
# (production URL and localhost).
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
# The tenant-line agent the browser call talks to (agent_…).
NEXT_PUBLIC_RETELL_AGENT_ID=

# Long random string; salts the hash of client IPs for rate limiting.
RATE_LIMIT_SALT=
